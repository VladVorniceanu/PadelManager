#include "Shared.xcconfig"
#include "Secrets.xcconfig"

API_BASE_URL = $(API_BASE_URL_DEBUG)
GAD_APPLICATION_IDENTIFIER = $(GAD_APPLICATION_IDENTIFIER_DEBUG)

// xcconfig requires Info.plist values containing $ to be exported as user-defined build settings
INFOPLIST_KEY_API_BASE_URL = $(API_BASE_URL)
INFOPLIST_KEY_GADApplicationIdentifier = $(GAD_APPLICATION_IDENTIFIER)
