// Copy this file to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is gitignored — never commit real secrets.
//
// xcconfig treats // as a comment — escape http:// with $()
API_BASE_URL_DEBUG    = http:/$()/localhost:4000/api
API_BASE_URL_RELEASE  = https:/$()/api.XXXX.app/api

// AdMob App IDs — get yours from https://apps.admob.com
// For Debug, prefer Google's official test app ID:
//   ca-app-pub-3940256099942544~1458002511
// to avoid impression abuse / account bans during development.
GAD_APPLICATION_IDENTIFIER_DEBUG    = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
GAD_APPLICATION_IDENTIFIER_RELEASE  = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
